{
  "name": "dsh-herdr-site",
  "version": "0.1.0",
  "description": "让 Herdr 认识 DSH 面板：把 agent 的 working/idle/blocked 状态报给 Herdr，支持面板跳转与 --wait。状态上报 / 终端集成。",
  "author": "WuJiaoJue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuJiaoJue/dsh-herdr-site.git"
  },
  "homepage": "https://github.com/WuJiaoJue/dsh-herdr-site",
  "bugs": {
    "url": "https://github.com/WuJiaoJue/dsh-herdr-site/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "herdr",
    "cordis",
    "plugin",
    "agent",
    "cc-tui",
    "dsh-tui"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  }
}
